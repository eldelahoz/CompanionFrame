{
  "name": "companionframe",
  "private": true,
  "description": "A free, open-source desktop companion for Warframe.",
  "license": "MIT",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --example export_bindings",
    "replay": "cargo run --manifest-path src-tauri/Cargo.toml --example replay && node scripts/replay/render.mjs",
    "game-data": "node scripts/copy-game-data.mjs",
    "fetch-onnx": "node scripts/fetch-onnx.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@wfcd/items": "1.1276.6",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "warframe-public-export-plus": "0.6.8"
  }
}
